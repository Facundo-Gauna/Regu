{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-academica.local/esquemas/calendario.schema.json",
  "title": "Calendario académico",
  "description": "Calendario académico de una facultad para uno o más ciclos lectivos. Todas las fechas son locales (America/Argentina/Cordoba) en formato AAAA-MM-DD.",
  "type": "object",
  "required": ["schemaVersion", "tipo", "id", "facultad", "versionDatos", "ciclosLectivos", "cuatrimestres", "periodosExamen", "feriados"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "tipo": { "const": "calendario" },
    "id": { "$ref": "#/$defs/id" },
    "facultad": { "type": "string" },
    "versionDatos": { "type": "string" },
    "fuentes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["descripcion"],
        "additionalProperties": false,
        "properties": {
          "descripcion": { "type": "string" },
          "url": { "type": "string" },
          "consultado": { "$ref": "#/$defs/fecha" }
        }
      }
    },
    "reglas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cierreInscripcionFinalHorasHabiles": { "type": "integer", "description": "Inscripción/anulación a final hasta N horas hábiles antes del examen" },
        "inscripcionCursadoDiasAntes": { "type": "integer", "description": "Ventana estimada: días antes del inicio del cuatrimestre" },
        "inscripcionCursadoDiasDespues": { "type": "integer", "description": "Ventana estimada: días después del inicio del cuatrimestre" }
      }
    },
    "ciclosLectivos": {
      "type": "array",
      "description": "Ciclo lectivo: del inicio de clases al último llamado de feb–mar del año siguiente (Ord. 1549 cap. 10)",
      "items": {
        "type": "object",
        "required": ["id", "inicio", "fin"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "description": "Año del ciclo" },
          "inicio": { "oneOf": [{ "$ref": "#/$defs/fecha" }, { "type": "null" }] },
          "fin": { "$ref": "#/$defs/fecha" }
        }
      }
    },
    "cuatrimestres": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ciclo", "cuatrimestre", "inicio", "fin"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "ciclo": { "type": "integer" },
          "cuatrimestre": { "enum": ["1C", "2C"] },
          "inicio": { "$ref": "#/$defs/fecha" },
          "fin": { "$ref": "#/$defs/fecha" },
          "inscripcion": {
            "type": "object",
            "description": "Ventana confirmada. Si falta, la app la estima con 'reglas'",
            "required": ["desde", "hasta"],
            "additionalProperties": false,
            "properties": {
              "desde": { "$ref": "#/$defs/fecha" },
              "hasta": { "$ref": "#/$defs/fecha" }
            }
          }
        }
      }
    },
    "periodosExamen": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tipo", "desde", "hasta", "inscripcionDesde"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "tipo": { "enum": ["turno", "mesas-moviles", "especial"], "description": "mesas-moviles = mesas de final durante el cursado" },
          "desde": { "$ref": "#/$defs/fecha" },
          "hasta": { "$ref": "#/$defs/fecha" },
          "inscripcionDesde": { "oneOf": [{ "$ref": "#/$defs/fecha" }, { "type": "null" }] },
          "verificar": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "recesos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nombre", "desde", "hasta"],
        "additionalProperties": false,
        "properties": {
          "nombre": { "type": "string" },
          "desde": { "$ref": "#/$defs/fecha" },
          "hasta": { "$ref": "#/$defs/fecha" }
        }
      }
    },
    "feriados": {
      "type": "array",
      "description": "Días no hábiles (para calcular horas hábiles)",
      "items": {
        "type": "object",
        "required": ["fecha", "nombre"],
        "additionalProperties": false,
        "properties": {
          "fecha": { "$ref": "#/$defs/fecha" },
          "nombre": { "type": "string" }
        }
      }
    },
    "eventos": {
      "type": "array",
      "description": "Otros eventos informativos (encuestas docentes, días institucionales)",
      "items": {
        "type": "object",
        "required": ["nombre", "desde", "hasta"],
        "additionalProperties": false,
        "properties": {
          "nombre": { "type": "string" },
          "desde": { "$ref": "#/$defs/fecha" },
          "hasta": { "$ref": "#/$defs/fecha" }
        }
      }
    },
    "verificar": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
