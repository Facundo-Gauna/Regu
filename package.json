{
  "name": "regu",
  "version": "0.1.0",
  "private": true,
  "description": "Regu: tu cursada en la UTN FRVM, en un solo lugar",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "validar-datos": "node herramientas/validar-datos.mjs",
    "check": "npm run typecheck && npm run validar-datos && npm test && npm run build",
    "e2e": "node herramientas/e2e.mjs",
    "iconos": "node herramientas/generar-iconos.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.10.1",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Facundo-Gauna/Regu.git"
  },
  "homepage": "https://github.com/Facundo-Gauna/Regu#readme"
}
